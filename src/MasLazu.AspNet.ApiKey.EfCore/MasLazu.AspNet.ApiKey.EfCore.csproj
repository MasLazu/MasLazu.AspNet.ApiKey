<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- NuGet Package Properties -->
    <PackageId>MasLazu.AspNet.ApiKey.EfCore</PackageId>
    <Authors>MasLazu</Authors>
    <Company>MasLazu</Company>
    <Description>EF Core implementation for MasLazu ASP.NET API Key management. Contains data access layer using Entity Framework Core.</Description>
    <PackageTags>aspnetcore;apikey;efcore;database;orm</PackageTags>
    <RepositoryUrl>https://github.com/maslazu/MasLazu.AspNet.ApiKey</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/maslazu/MasLazu.AspNet.ApiKey</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See RELEASES.md for release notes.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MasLazu.AspNet.Framework.EfCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MasLazu.AspNet.ApiKey.Domain\MasLazu.AspNet.ApiKey.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
